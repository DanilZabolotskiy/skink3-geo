{
  "name": "skink3-geo",
  "private": true,
  "version": "0.1.0",
  "description": "Real geographic data turned into simplified vector map layers of a city: the country round it, water, relief, walls, streets, built-up land and the city's outline through time; and the Earth or the Moon for a globe. Deterministic, with the credit of every source.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "exports": {
    ".": "./map.ts",
    "./build.mjs": "./build.mjs",
    "./globe.mjs": "./globe.mjs",
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  },
  "files": [
    "build.mjs",
    "globe.mjs",
    "globe.d.mts",
    "map.ts",
    "lib",
    "examples",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.*\"",
    "check": "tsc --noEmit && node --test \"test/*.test.*\"",
    "example": "node build.mjs valletta --root examples --preview"
  },
  "dependencies": {
    "skia-canvas": "4.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
